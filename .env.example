# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- Oracle (api) ---
# Native Oracle 19c EE instance. node-oracledb runs in thin mode, no Instant Client needed.
DB_USER=ecomm
DB_PASSWORD=changeme
DB_DSN="host:1521/service_name"
DB_POOL_MIN=2
DB_POOL_MAX=10

# Separate DB user for withPlatform() — exempt from VPD policies, used only by Super Admin routes.
DB_PLATFORM_USER=ecomm_platform
DB_PLATFORM_PASSWORD=changeme

# --- Redis (api) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Auth (api) ---
JWT_ACCESS_SECRET=changeme
JWT_REFRESH_SECRET=changeme
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Platform admin bootstrap (scripts/seed-platform-admin.js, one-time/idempotent) ---
PLATFORM_ADMIN_EMAIL=super@example.com
PLATFORM_ADMIN_PASSWORD=changeme

# --- API server ---
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# --- Storefront / Admin / Superadmin (public, non-secret) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
VITE_API_URL=http://localhost:4000
