# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- Oracle (api) ---
# Native Oracle 19c EE instance. node-oracledb runs in thin mode, no Instant Client needed.
DB_USER=ecomm
DB_PASSWORD=changeme
DB_DSN="host:1521/service_name"
DB_POOL_MIN=2
DB_POOL_MAX=10

# Separate DB user for withPlatform() — exempt from VPD policies, used only by Super Admin routes.
DB_PLATFORM_USER=ecomm_platform
DB_PLATFORM_PASSWORD=changeme

# --- Redis (api) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Auth (api) ---
JWT_ACCESS_SECRET=changeme
JWT_REFRESH_SECRET=changeme
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Platform admin bootstrap (scripts/seed-platform-admin.js, one-time/idempotent) ---
PLATFORM_ADMIN_EMAIL=super@example.com
PLATFORM_ADMIN_PASSWORD=changeme

# --- Transactional email (api) ---
# 'log' (default) writes rendered emails to the server log — no setup needed
# for local dev. Switch to 'smtp' and fill in the block below for a real send.
EMAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

# --- API server ---
PORT=8003
NODE_ENV=development
LOG_LEVEL=debug

# --- Storefront / Admin / Superadmin (public, non-secret) ---
API_URL=http://localhost:8003
VITE_API_URL=http://localhost:8003

# --- CORS (api) ---
# Origins allowed on top of the stores' own domains (which come from the
# `domains` table). The admin and Super Admin panels, comma-separated.
ADMIN_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Storefront cache revalidation (api -> storefront) ---
# The API calls the storefront's /api/revalidate after any write, so a client
# sees their own change immediately instead of waiting out the cache window.
# Leave both unset to turn tag-based revalidation off (the storefront then
# falls back to its own 60-second windows).
STOREFRONT_URL=http://localhost:3001
REVALIDATE_SECRET=changeme

# --- Error tracking (api) ---
# Unset (the default) reports errors to the log and loads no agent at all.
# Set it to enable Sentry; `npm install --workspace=api @sentry/node` first.
SENTRY_DSN=
SENTRY_RELEASE=

# --- Logging ---
# Production writes rotated files here as well as to stdout.
LOG_DIR=
